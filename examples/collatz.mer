// collatz.mer
// Computes the number of steps required to reach 1 using the Collatz conjecture.

fn collatz_steps(n: Number) -> Number {
    if n == 1 {
        0
    } else {
        if is_even(n) == 1 {
            let next_n = n / 2;
            1 + collatz_steps(next_n)
        } else {
            let next_n = 3 * n + 1;
            1 + collatz_steps(next_n)
        }
    }
}

fn is_even(n: Number) -> Number {
    if n == 0 {
        1
    } else if n == 1 {
        0
    } else {
        is_even(n - 2)
    }
}

let start = 15;
print collatz_steps(start);
